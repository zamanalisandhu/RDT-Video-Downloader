{
  "manifest_version": 3,
  "name": "RDT Video Downloader - Save Reddit Videos with Audio",
  "short_name": "RDT Downloader",
  "version": "1.0.0",
  "description": "Download Reddit videos with sound in HD. One-click download button on every Reddit video post. No watermarks, no signup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://rdtapidownload.techiesline.workers.dev/*",
    "https://*.reddit.com/*",
    "https://*.redd.it/*",
    "https://*.redditmedia.com/*",
    "https://reddit-uploaded-video.s3-accelerate.amazonaws.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "RDT Video Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://old.reddit.com/*",
        "https://new.reddit.com/*",
        "https://www.reddit.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*.reddit.com/*"]
    }
  ]
}
